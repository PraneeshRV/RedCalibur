## RedCalibur environment configuration
# Copy this file to .env and fill values where applicable

### AI configuration
# Google Gemini API key (enables AI analysis across tools)
GEMINI_API_KEY=

# Optional: NVD/CVE configuration (if you add an API key for higher limits)
# NVD_API_KEY=

### Output and logging
# Where reports (JSON/PDF/MD) are written
REDCALIBUR_OUTPUT_DIR=./reports
# Log level for backend and library (DEBUG, INFO, WARNING, ERROR)
REDCALIBUR_LOG_LEVEL=INFO

### Optional third-party enrichments (not required)
# SHODAN_API_KEY=
# VIRUSTOTAL_API_KEY=
# HUNTER_API_KEY=
